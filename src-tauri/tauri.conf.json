{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "onebox",
  "version": "0.1.0",
  "identifier": "com.onebox.editor",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{
      "label": "main",
      "title": "",
      "width": 1100,
      "height": 760,
      "dragDropEnabled": false
    }],
    "security": { "csp": null }
  },
  "bundle": {
    "active": false,
    "targets": "all",
    "icon": ["icons/onebox.png", "icons/onebox.icns", "icons/onebox.ico"]
  }
}
